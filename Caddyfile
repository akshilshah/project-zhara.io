# Canonical host is the apex; www redirects so crawlers index one copy of each page
www.zhara.io {
	redir https://zhara.io{uri} permanent
}

zhara.io {
	root * /home/ubuntu/project-zhara.io
	encode gzip zstd

	# Everything public is served. Only repo/internal files are hidden.
	@internal path /Caddyfile /DESIGN.md /tools/* /change-request/* /logo-v2/* /screenshots/*
	respond @internal 404

	# Dotfiles and dot-directories (.env, .git, .gstack, .DS_Store), except .well-known
	@dotfiles {
		path_regexp /\.
		not path /.well-known/*
	}
	respond @dotfiles 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Assets have stable filenames — cache 1 day, not immutable
	header /assets/* Cache-Control "public, max-age=86400"

	# Crawler and AI-agent files: open to any origin, short cache
	@meta path /robots.txt /llms.txt /llms-full.txt /sitemap.xml
	header @meta {
		Cache-Control "public, max-age=3600"
		Access-Control-Allow-Origin *
	}

	@html path / *.html */
	header @html Cache-Control "public, max-age=3600"

	file_server
}
