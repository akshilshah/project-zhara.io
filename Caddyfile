zhara.io, www.zhara.io {
	root * /home/ubuntu/project-zhara.io
	encode gzip zstd

	# Allowlist: page, assets, and production meta files — 404 everything else
	@denied {
		not path / /index.html /assets/* /robots.txt /sitemap.xml /llms.txt /favicon.ico /site.webmanifest /privacy /privacy/* /terms /legal/* /help /help/*
	}
	respond @denied 404

	# Assets have stable filenames — cache 1 day, not immutable
	header /assets/* Cache-Control "public, max-age=86400"

	@html {
		path / /index.html /privacy/* /legal/* /help /help/*
	}
	header @html Cache-Control "public, max-age=3600"

	file_server
}
